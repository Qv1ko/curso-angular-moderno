{
  "name": "activity-bookings",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "chrome": "start chrome -incognito -auto-open-devtools-for-tabs http://localhost:4200",
    "sc": "npm run chrome && npx ng serve --force-esbuild",
    "start": "ng serve",
    "build": "ng build",
    "http-server": "npx http-server dist/ActivityBookings/browser -c-1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:ActivityBookings": "node dist/ActivityBookings/server/server.mjs",
    "serve": "npm run build && npm run serve:ssr:ActivityBookings",
    "api": "json-server-auth ./db/prod/d.json -r ./db/r.json",
    "api:reset": "copyfiles -f ./db/reset/d.json ./db/prod && npm run api",
    "api:seed": "copyfiles -f ./db/seed/d.json ./db/prod && npm run api",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "@picocss/pico": "^2.1.1",
    "copyfiles": "^2.4.1",
    "express": "^5.1.0",
    "json-server": "^1.0.0-beta.15",
    "json-server-auth": "^2.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "npm@11.17.0"
}
